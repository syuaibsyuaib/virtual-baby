      "pembicara": "Syuaib",
      "ucapan": "Gugu... ga!",
      "indera_terlibat": ["pendengaran"]
    },
    {
      "pembicara": "Ayah Idris",
      "ucapan": "Assalamu'alaikum, Syuaib. Ayah datang melihat jagoan kecil Ayah.",
