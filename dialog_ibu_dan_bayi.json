      "ucapan": "Hehe... eee...",
      "indera_terlibat": ["pendengaran"]
    },
    {
      "pembicara": "Ibu Syamsiah",
      "ucapan": "Ibu anggap itu jawaban ‘iya’. Yuk, kita ganti popok dulu supaya nyaman.",
      "indera_terlibat": ["pendengaran", "peraba"]
    },
    {
      "pembicara": "Syuaib",
      "ucapan": "Uaa... uaa...",
      "indera_terlibat": ["pendengaran", "peraba"]
    },
    {
      "pembicara": "Ibu Syamsiah",
      "ucapan": "Sebentar saja, Nak. Ibu di sini, kok. Tidak perlu khawatir.",
      "indera_terlibat": ["pendengaran", "peraba"]
