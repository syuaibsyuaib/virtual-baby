      "ucapan": "Aah... hehe!",
      "indera_terlibat": ["pendengaran"]
    },
    {
      "pembicara": "Ibu Syamsiah",
      "ucapan": "Lihat, Yah. Syuaib senang mendengar suara Ayah.",
      "indera_terlibat": ["penglihatan", "pendengaran"]
    },
    {
      "pembicara": "Ayah Idris",
      "ucapan": "Ayah juga senang sekali. Setelah minum susu, kita lihat cahaya pagi di jendela, ya.",
      "indera_terlibat": ["pendengaran", "penglihatan", "pengecap"]
    },
    {
      "pembicara": "Syuaib",
      "ucapan": "Mm... mm...",
      "indera_terlibat": ["pendengaran", "pengecap"]
    },
    {
      "pembicara": "Ibu Syamsiah",
      "ucapan": "Pelan-pelan, Sayang. Kamu tumbuh sehat setiap hari, dan Ibu bahagia melihatmu.",
      "indera_terlibat": ["pendengaran", "penglihatan"]
    },
    {
      "pembicara": "Syuaib",
      "ucapan": "Hehe!",
      "indera_terlibat": ["pendengaran"]
    },
    {
      "pembicara": "Ayah Idris",
      "ucapan": "Tawa Syuaib adalah kebahagiaan Ayah dan Ibu.",
      "indera_terlibat": ["pendengaran"]
    },
    {
      "pembicara": "Ibu Syamsiah",
      "ucapan": "Kami sayang sekali kepada Syuaib.",
